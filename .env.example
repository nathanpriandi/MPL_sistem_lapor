# ==============================================================================
# SISTEM LAPOR MPL — ENVIRONMENT VARIABLES & SCRIPT PROPERTIES TEMPLATE
# ==============================================================================
# In Google Apps Script, these values are stored in Project Settings > Script Properties.
# When utilizing clasp or local CLI tools, populate your local .env file accordingly.
# NEVER commit .env or .clasp.json with production secrets to version control.
# ==============================================================================

# Core Database & Application Identifiers
SPREADSHEET_ID="your_google_spreadsheet_id_here"
MAIN_FORM_ID="your_google_form_id_here"

# Web App Deployment Endpoints
PUBLIC_WEB_APP_URL="https://script.google.com/macros/s/DEPLOYMENT_ID_A/exec"
INTERNAL_WEB_APP_URL="https://script.google.com/macros/s/DEPLOYMENT_ID_B/exec"
PUBLIC_DEPLOYMENT_ID="DEPLOYMENT_ID_A"

# Administrator & Notification Recipients
ADMIN_EMAIL="admin.operasional@perusahaan.co.id"
MANAGER_EMAIL="manager.eksekutif@perusahaan.co.id"

# Storage & Retention Configurations
RETENTION_DAYS="90"
DRIVE_PHOTO_FOLDER_ID=""
